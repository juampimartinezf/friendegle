PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
DB_PATH=./friendegle.db

# --- TURN (privacidad de IP) ---
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
STUN_URL=stun:stun.l.google.com:19302
# Local: usuario estático definido en coturn/turnserver.conf
TURN_USER=friendegle
TURN_PASS=friendegle123
# Producción: pon aquí el mismo static-auth-secret de turnserver.prod.conf
# (si está definido, se ignoran TURN_USER/TURN_PASS y se usan credenciales efímeras)
TURN_SECRET=

# --- Opcionales ---
# Orígenes CORS separados por comas (CLIENT_ORIGIN arriba admite lista)
# '1' si hay un reverse proxy delante (en producción lo fija docker-compose.yml)
# TRUST_PROXY=
# Rate limits: peticiones/15 min por IP a la API y a login/registro; eventos de socket/10 s por conexión
# RATE_LIMIT_API=600
# RATE_LIMIT_AUTH=20
# RATE_LIMIT_SOCKET=120
# 'production' activa la validación estricta (solo para probar; en producción real usa deploy/)
# NODE_ENV=

# Variables del build de producción del frontend (Vite).
# En Vercel NO hace falta este archivo: define las variables en
# Project → Settings → Environment Variables (entorno "Production").
# Si prefieres usar el archivo, cópialo a .env.production (Vite lo lee al hacer `npm run build`).

# URL pública HTTPS del backend en DigitalOcean, sin barra final.
# Se usa para las llamadas REST (/api/...) y para el WebSocket de señalización.
# También se añade a la Content-Security-Policy (connect-src). Es pública: no pongas secretos aquí.
VITE_API_URL=https://api.tu-dominio.com

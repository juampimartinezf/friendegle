# =============================================================================
#  Friendegle — variables de PRODUCCIÓN del servidor (DigitalOcean)
# =============================================================================
#  `./deploy.sh init` crea deploy/.env.production a partir de este archivo,
#  generando JWT_SECRET y TURN_SECRET aleatorios y detectando la IP del Droplet.
#  deploy/.env.production NUNCA se sube a git (está en .gitignore).
#
#  Lo leen: docker compose (para interpolar docker-compose.yml) y deploy.sh.
#  El backend recibe sus variables desde docker-compose.yml, no de este archivo directamente.
# =============================================================================

# --- Dominios y red ----------------------------------------------------------

# Subdominio del backend (API REST + WebSocket de señalización). Caddy obtiene su
# certificado HTTPS automáticamente. Registro DNS A → PUBLIC_IP.
API_DOMAIN=api.tu-dominio.com

# Subdominio del servidor TURN. Caddy obtiene también su certificado y
# sync-turn-certs.sh se lo copia a coturn para `turns:` (TLS, puerto 5349). DNS A → PUBLIC_IP.
TURN_DOMAIN=turn.tu-dominio.com

# IP pública del Droplet. Coturn la anuncia como dirección de relay.
PUBLIC_IP=203.0.113.10

# Email para Let's Encrypt (avisos de caducidad de certificados).
ACME_EMAIL=tu-email@tu-dominio.com

# Origen(es) del frontend permitidos por CORS, separados por comas, https y sin barra final.
# Solo tu dominio de Vercel. Las URLs de preview de Vercel quedan bloqueadas a propósito.
CLIENT_ORIGIN=https://tu-dominio.com,https://www.tu-dominio.com

# Email(s) de las cuentas con acceso al panel de Moderación (/admin), separados por comas.
# Regístrate en la web con ese email para poder revisar reportes y suspender usuarios.
ADMIN_EMAILS=tu-email@tu-dominio.com

# --- Secretos (genera cada uno con: openssl rand -hex 32) --------------------

# Firma los JWT de sesión. Si cambia, todas las sesiones se cierran. Mínimo 32 caracteres.
JWT_SECRET=

# Secreto compartido entre backend y coturn para las credenciales TURN temporales
# (caducan a las 4 h). Obligatorio: sin él el backend no arranca. Mínimo 32 caracteres.
TURN_SECRET=

# --- Opcionales (valores por defecto entre paréntesis) ------------------------

# STUN anunciado a los clientes (stun:stun.l.google.com:19302). Con la política 'relay' no se usa.
# STUN_URL=stun:stun.l.google.com:19302

# Peticiones por IP cada 15 min a toda la API (600) y a login/registro (20).
# RATE_LIMIT_API=600
# RATE_LIMIT_AUTH=20
# Eventos de socket por conexión cada 10 s antes de desconectarla (120).
# RATE_LIMIT_SOCKET=120

# --- Base de datos ------------------------------------------------------------
# No hay DATABASE_URL: Friendegle usa SQLite (better-sqlite3) en un volumen de Docker
# (friendegle_db → /data/friendegle.db dentro del contenedor). Cambiar a Postgres
# implicaría reescribir la capa de datos. Copias de seguridad: ./deploy.sh backup
